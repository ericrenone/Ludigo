class AgentNode:
    """
    Individual Agent - NEXUS Layer Implementation
   
    Combines all LCM layers:
    • PULSE: Receives MCMC-scheduled execution time
    • LINK: Communicates via DAG predecessors
    • NEXUS: Maintains core Q16.16 state
    • VAULT: Performs Lévy-flight exploration
    • HELIX: Ensures Hamiltonian structural integrity
    """
   
    def __init__(self, agent_id: int, dim: int = 4, predecessors: Optional[List['AgentNode']] = None,
                 rng: Optional[SeededRNG] = None, alpha: float = 0.03125):
        """
        Initialize agent node.
       
        Args:
            agent_id: Unique agent identifier
            dim: State vector dimensionality
            predecessors: List of predecessor agents in DAG (LINK layer)
            rng: Shared deterministic RNG (for VAULT)
            alpha: VAULT perturbation magnitude
        """
        self.id = agent_id
        self.dim = dim
        self.pred = predecessors or []
        self.rng = rng
        self.alpha = Q1616(alpha)
       
        # Weights (initialized after DAG structure finalized)
        self.W = None # Shape: (dim, input_dim)
        self.b = qarray(np.zeros(dim)) # Bias
       
        # NEXUS: Core state vectors
        self.x_self = qarray(np.zeros(dim)) # Current state
       
        # VAULT: Momentum for optimization
        self.momentum = qarray(np.zeros(dim)) # LEVBOT momentum
       
        # HELIX: Hamiltonian momentum
        self.p_momentum = qarray(np.zeros(dim)) # Hamiltonian conjugate momentum
       
        # Temporary (computed each PULSE cycle)
        self.x_link = None # LINK aggregation result
       
        # TRUE-PATH: Local state history
        self.state_history = []
   
    def link_forward(self) -> np.ndarray:
        """
        LINK: DAG-based forward propagation.
       
        Aggregates information from predecessors via weighted connections:
        x_i^in = Σ_{j ∈ pred(i)} W_ij · x_j
       
        Returns:
            Aggregated state vector (Q1616 array)
        """
        # Concatenate self state with predecessor states
        inputs = [self.x_self] + [p.x_self for p in self.pred]
        concat = np.concatenate([[y.to_float() for y in arr] for arr in inputs])
       
        # Matrix multiply (convert to float for intermediate computation)
        W_float = np.array([[w.to_float() for w in row] for row in self.W])
        b_float = np.array([bi.to_float() for bi in self.b])
        z_float = np.dot(W_float, concat) + b_float
       
        # Convert back to Q1616 and apply ReLU activation
        return np.array([Q1616(z).relu() for z in z_float], dtype=object)
   
    def vault_explore(self, x: np.ndarray) -> np.ndarray:
        """
        VAULT: Lévy-flight stochastic exploration.
       
        Implements "Deterministic Lucky Curiosity" via heavy-tailed jumps:
        Δx ~ Lévy_α(u), α ∈ (1,2]
       
        Enables sparse global exploration to escape local optima.
       
        Args:
            x: Input state vector
       
        Returns:
            Perturbed state vector
        """
        # Generate Lévy-flight perturbation
        levy_noise = self.rng.levy_flight(alpha=1.5, size=self.dim)
       
        # Scale by alpha parameter
        perturbation = np.array([self.alpha * lev for lev in levy_noise], dtype=object)
       
        # Apply perturbation
        return np.array([xi + p for xi, p in zip(x, perturbation)], dtype=object)
   
    def vault_levbot(self, x: np.ndarray, beta: float = 0.05, mu: float = 0.9, eps: float = 1e-6) -> np.ndarray:
        """
        VAULT: LEVBOT momentum-based optimization.
       
        Implements adaptive gradient descent with momentum:
        v_{t+1} = μ·v_t + (1-μ)·∇R
        x_{t+1} = x_t + β·v_{t+1}/||v_{t+1}||
       
        Args:
            x: Input state vector
            beta: Step size
            mu: Momentum coefficient
            eps: Numerical stability constant
       
        Returns:
            Refined state vector
        """
        # Compute gradient (simple example: gradient = -0.1 * x)
        x_floats = np.array([xi.to_float() for xi in x])
        grad_floats = -x_floats * 0.1
        grad = qarray(grad_floats)
       
        # Update momentum: m = μ·m + (1-μ)·g
        mom_floats = np.array([m.to_float() for m in self.momentum])
        g_floats = np.array([g.to_float() for g in grad])
        new_mom_floats = mu * mom_floats + (1 - mu) * g_floats
        self.momentum = qarray(new_mom_floats)
       
        # Compute normalized step: step = (β / ||m||) · m
        norm = math.sqrt(sum(v.to_float() ** 2 for v in self.momentum)) + eps
        step_floats = (beta / norm) * np.array([v.to_float() for v in self.momentum])
        step = qarray(step_floats)
       
        # Apply update
        return np.array([xi + s for xi, s in zip(x, step)], dtype=object)
   
    def helix_hamiltonian(self, x: np.ndarray, gamma: float = 0.9, delta_t: float = 0.1) -> np.ndarray:
        """
        HELIX: Hamiltonian-Inspired Dynamics.
       
        Implements symplectic leapfrog integration for structural integrity:
        v_{t+1/2} = γ·v_t - Δt/2 · ∇U(q_t)
        q_{t+1} = q_t + Δt · v_{t+1/2}
        v_{t+1} = v_{t+1/2} - Δt/2 · ∇U(q_{t+1})
       
        Ensures energy conservation and prevents "neckpinch" singularities.
       
        Args:
            x: Position (state) vector
            gamma: Friction coefficient
            delta_t: Time step
       
        Returns:
            Updated state vector with Hamiltonian constraints
        """
        # Compute potential gradient (force)
        x_floats = np.array([xi.to_float() for xi in x])
        grad_floats = -x_floats * 0.1 # Simple quadratic potential
       
        # Half-step momentum update: p = γ·p - Δt/2·∇U
        p_floats = np.array([p.to_float() for p in self.p_momentum])
        new_p_floats = gamma * p_floats - (delta_t / 2) * grad_floats
        self.p_momentum = qarray(new_p_floats)
       
        # Position update: q = q + Δt·p
        q_new = np.array([
            xi + Q1616(delta_t * pm.to_float())
            for xi, pm in zip(x, self.p_momentum)
        ], dtype=object)
       
        # Second half-step momentum update
        q_new_floats = np.array([qi.to_float() for qi in q_new])
        grad_new_floats = -q_new_floats * 0.1
        p_floats = np.array([pm.to_float() for pm in self.p_momentum])
        final_p_floats = p_floats - (delta_t / 2) * grad_new_floats
        self.p_momentum = qarray(final_p_floats)
       
        return q_new
   
    def reward_scalar(self, x: np.ndarray) -> Q1616:
        """
        Compute reward (negative energy) for state x.
       
        Multi-objective formulation:
        R(x) = -||x||₂ + 0.1·sin(id + Σx_i)
       
        Components:
        • Norm penalty: Encourages compact states
        • Sinusoidal: Creates local optima for exploration
        • Agent ID: Breaks symmetry between agents
       
        Args:
            x: State vector
       
        Returns:
            Scalar reward (Q1616)
        """
        floats = [xi.to_float() for xi in x]
        norm = sum(f ** 2 for f in floats) ** 0.5
        sin_arg = self.id + sum(floats)
        reward_val = -norm + 0.1 * math.sin(sin_arg)
        return Q1616(reward_val)

    def energy(self, x: np.ndarray = None) -> float:
        """Compute energy as negative reward."""
        if x is None:
            x = self.x_self
        return -self.reward_scalar(x).to_float()
   
    def get_state_hex(self) -> str:
        """Get hexadecimal representation of state for TRUE-PATH."""
        return "".join(x.to_hex() for x in self.x_self)
