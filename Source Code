# SEEDED RNG (Deterministic Randomness for VAULT)
# =============================================================================
class SeededRNG:
    """
    Deterministic Random Number Generator for VAULT (Lévy-flight exploration).
   
    Ensures bit-identical randomness across platforms by explicit state management.
    Critical for reproducible stochastic exploration in VAULT layer.
    """
   
    def __init__(self, seed: int = 42):
        """Initialize with deterministic seed."""
        self.seed = seed
        self.reset()
   
    def reset(self):
        """Reset to initial seeded state."""
        random.seed(self.seed)
        self.state = random.getstate()
   
    def uniform(self, low: float = -1.0, high: float = 1.0,
                size: Optional[Union[int, Tuple[int, ...]]] = None) -> Union[Q1616, np.ndarray]:
        """Generate uniform random Q1616 number(s)."""
        random.setstate(self.state)
       
        if size is None:
            u = random.uniform(low, high)
            self.state = random.getstate()
            return Q1616(u)
        else:
            if isinstance(size, int):
                size = (size,)
            arr = [random.uniform(low, high) for _ in range(np.prod(size))]
            self.state = random.getstate()
            return qarray(np.array(arr).reshape(size))
   
    def levy_flight(self, alpha: float = 1.5, size: Optional[int] = None) -> Union[Q1616, np.ndarray]:
        """
        Generate Lévy-flight random variable(s) for VAULT exploration.
       
        Uses heavy-tailed distribution for "deterministic lucky curiosity":
        enabling sparse global jumps to escape local optima.
       
        Args:
            alpha: Stability parameter (1 < alpha ≤ 2)
            size: Number of samples (None for scalar)
        """
        random.setstate(self.state)
       
        def levy_sample():
            # Mantegna's method for Lévy-stable distribution
            sigma_u = (math.gamma(1 + alpha) * math.sin(math.pi * alpha / 2) /
                      (math.gamma((1 + alpha) / 2) * alpha * (2 ** ((alpha - 1) / 2)))) ** (1 / alpha)
           
            u = random.gauss(0, sigma_u)
            v = random.gauss(0, 1)
           
            return u / (abs(v) ** (1 / alpha))
       
        if size is None:
            result = levy_sample()
            self.state = random.getstate()
            # Clamp to reasonable range for Q16.16
            return Q1616(max(-10.0, min(10.0, result)))
        else:
            samples = [levy_sample() for _ in range(size)]
            self.state = random.getstate()
            # Clamp all samples
            clamped = [max(-10.0, min(10.0, s)) for s in samples]
            return qarray(np.array(clamped))
