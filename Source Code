# Q16.16 FIXED-POINT ARITHMETIC (Native Token Machine Layer)
# =============================================================================
class Q1616:
    """
    Q16.16 Fixed-Point Arithmetic - Native Token Machine (NTM) Foundation
   
    Implements deterministic 32-bit fixed-point arithmetic for bit-identical
    reproducibility across x86, ARM, RISC-V, and FPGA architectures.
   
    Mathematical Properties:
    • Lattice: x ∈ {k·2^-16 : k ∈ ℤ, |k| < 2^31}
    • Associative: (a+b)+c = a+(b+c) (eliminates floating-point drift)
    • Hamming Distance: d_H = 0 (perfect cross-platform identity)
   
    Hardware Mapping:
    • FPGA: Gowin GW5A DSP9 MAC units
    • ASIC: AXON SOLO deterministic ALU
    • CPU: Standard integer ops (no FPU variance)
    """
   
    __slots__ = ('q',) # Memory optimization
   
    SCALE = CONFIG.Q16_SCALE
    SHIFT = CONFIG.Q16_SHIFT
    MIN = CONFIG.Q16_MIN
    MAX = CONFIG.Q16_MAX
   
    def __init__(self, value: Union[float, int, 'Q1616']):
        """Initialize Q16.16 from float, int, or another Q1616."""
        if isinstance(value, float):
            q = int(round(value * self.SCALE))
        elif isinstance(value, int):
            q = value
        elif isinstance(value, Q1616):
            q = value.q
        else:
            raise TypeError(f"Cannot create Q1616 from {type(value)}")
       
        # Saturation clamping (prevents overflow)
        self.q = max(self.MIN, min(self.MAX, q))
   
    def __add__(self, other: Union['Q1616', float, int]) -> 'Q1616':
        """Deterministic addition with saturation."""
        if isinstance(other, Q1616):
            return Q1616(self.q + other.q)
        elif isinstance(other, float):
            return Q1616(self.q + int(round(other * self.SCALE)))
        elif isinstance(other, int):
            return Q1616(self.q + (other << self.SHIFT))
        return NotImplemented
   
    def __sub__(self, other: Union['Q1616', float, int]) -> 'Q1616':
        """Deterministic subtraction with saturation."""
        if isinstance(other, Q1616):
            return Q1616(self.q - other.q)
        elif isinstance(other, float):
            return Q1616(self.q - int(round(other * self.SCALE)))
        elif isinstance(other, int):
            return Q1616(self.q - (other << self.SHIFT))
        return NotImplemented
   
    def __mul__(self, other: Union['Q1616', float, int]) -> 'Q1616':
        """Deterministic multiplication with rounding."""
        if isinstance(other, Q1616):
            prod = self.q * other.q
            # Deterministic rounding (banker's rounding for ties)
            if prod >= 0:
                rounded = (prod + (1 << (self.SHIFT - 1))) >> self.SHIFT
            else:
                rounded = (prod - (1 << (self.SHIFT - 1))) >> self.SHIFT
            return Q1616(rounded)
        elif isinstance(other, (float, int)):
            return Q1616(int(round(self.q * other)))
        return NotImplemented
   
    def __truediv__(self, other: Union['Q1616', float, int]) -> 'Q1616':
        """Deterministic division (use sparingly - less precise)."""
        if isinstance(other, Q1616):
            if other.q == 0:
                raise ZeroDivisionError("Q1616 division by zero")
            scaled = self.q << self.SHIFT
            return Q1616(scaled // other.q)
        elif isinstance(other, (float, int)):
            if other == 0:
                raise ZeroDivisionError("Q1616 division by zero")
            return Q1616(int(round(self.q / other)))
        return NotImplemented
   
    def relu(self) -> 'Q1616':
        """ReLU activation: max(0, x)."""
        return Q1616(max(0, self.q))
   
    def tanh_approx(self) -> 'Q1616':
        """Approximated tanh using polynomial (FPGA-friendly)."""
        # tanh(x) ≈ x for small x, clamp to [-1,1]
        x = self.to_float()
        if abs(x) > 2.0:
            return Q1616(1.0 if x > 0 else -1.0)
        # Polynomial approximation
        result = x * (1 - 0.16 * x**2)
        return Q1616(result)
   
    def to_float(self) -> float:
        """Convert to Python float (for display/interfacing only)."""
        return self.q / self.SCALE
   
    def to_hex(self) -> str:
        """Convert to hex string for TRUE-PATH hashing."""
        return f"{self.q:08x}"
   
    def __float__(self) -> float:
        return self.to_float()
   
    def __repr__(self) -> str:
        return f"Q1616({self.to_float():.6f})"
   
    def __str__(self) -> str:
        return f"{self.to_float():.6f}"
   
    def __eq__(self, other) -> bool:
        if isinstance(other, Q1616):
            return self.q == other.q
        return False
   
    def __hash__(self) -> int:
        return hash(self.q)
def qarray(arr, shape=None):
    """Convert array to Q1616 NumPy object array."""
    if isinstance(arr, (list, tuple)):
        arr = np.array(arr)
    else:
        arr = np.asarray(arr)
   
    if shape is not None:
        arr = arr.reshape(shape)
   
    flat = arr.flatten()
    q_flat = [Q1616(x) for x in flat]
    return np.array(q_flat, dtype=object).reshape(arr.shape)
