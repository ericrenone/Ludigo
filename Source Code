# TRUE-PATH PROTOCOL (Cryptographic Verification)
# =============================================================================
class TruePathProtocol:
    """
    TRUE-PATH: SHA-256 Blockchain of Logic
   
    Cryptographic verification protocol that creates an immutable chain of
    state transitions. Any deviation triggers "Path Deviation" flag.
   
    Properties:
    • Collision resistance: 2^256 space
    • Determinism detection: Single bit difference → completely different hash
    • Cross-platform verification: Enables distributed Byzantine tolerance
    """
   
    @staticmethod
    def compute_hash(data: Union[str, bytes, List[Q1616]]) -> str:
        """Compute SHA-256 hash of data."""
        h = hashlib.sha256()
       
        if isinstance(data, str):
            h.update(data.encode())
        elif isinstance(data, bytes):
            h.update(data)
        elif isinstance(data, list):
            # Hash Q1616 array
            for item in data:
                if isinstance(item, Q1616):
                    h.update(item.to_hex().encode())
                else:
                    h.update(str(item).encode())
        else:
            h.update(str(data).encode())
       
        return h.hexdigest()
   
    @staticmethod
    def verify_path(hash_chain: List[str]) -> bool:
        """
        Verify hash chain integrity.
       
        Returns True if chain is valid (no path deviation detected).
        """
        if len(hash_chain) < 2:
            return True
       
        # Check for any hash collisions or unexpected changes
        # In production, would verify against expected deterministic sequence
        return len(set(hash_chain)) == len(hash_chain)
   
    @staticmethod
    def create_manifest(agent_states: Dict[int, List[Q1616]]) -> str:
        """
        Create global state manifest hash.
       
        Combines all agent states into single cryptographic fingerprint.
        """
        h = hashlib.sha256()
       
        # Sort by agent ID for consistency
        for agent_id in sorted(agent_states.keys()):
            state = agent_states[agent_id]
            state_hex = "".join(x.to_hex() for x in state)
            h.update(f"{agent_id}:{state_hex}".encode())
       
        return h.hexdigest()
