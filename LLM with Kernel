def example_llm_state_interpreter():
    """
    Example: Run deterministic kernel, use LLM to interpret results.
    
    Kernel maintains perfect reproducibility, LLM provides human-readable
    analysis and insights.
    """
    print("\n" + "="*70)
    print("EXAMPLE 3: LLM FOR STATE INTERPRETATION")
    print("="*70)
    
    llm = OllamaClient(model="llama2")
    
    if not llm.is_available():
        print("❌ Ollama not available. Please start it with: ollama serve")
        return
    
    print("✓ Ollama connected")
    
    # Run kernel deterministically
    print("\nRunning deterministic kernel...")
    kernel = AgentKernel(n_nodes=6, dim=4, seed=4242, format='Q1616')
    initial_hash = kernel.hash_state()
    
    for t in range(10):
        kernel.step(K_mcmc=12, tau=0.2, beta=0.08, verbose=False)
    
    final_hash = kernel.hash_state()
    print(f"✓ Initial hash: {initial_hash}")
    print(f"✓ Final hash: {final_hash}")
    
    # Collect state information
    state_summary = []
    for node in kernel.nodes:
        state_vals = [x.to_float() for x in node.x_self]
        magnitude = sum(v**2 for v in state_vals)**0.5
        state_summary.append({
            'id': node.id,
            'state': state_vals,
            'magnitude': magnitude
        })
    
    # Ask LLM to interpret
    prompt = f"""Analyze this multi-agent system state after 10 optimization steps:

Agents:
{json.dumps(state_summary, indent=2)}

The system uses MCMC to minimize state magnitude while exploring.

Provide a brief analysis:
1. Which agents are most/least active?
2. Are there any patterns in the state values?
3. What might be happening in the system?

Keep response under 150 words."""
    
    print("\nAsking LLM to interpret state...")
    interpretation = llm.generate(prompt, temperature=0.5, max_tokens=200)
    
    print("\nLLM Interpretation:")
    print("-" * 70)
    print(interpretation)
    print("-" * 70)
    
    print(f"\n✓ Analysis complete")
    print("✓ Kernel state remains deterministic and verifiable")


