def example_llm_deterministic_seeding():
    """
    Example: Use LLM output to generate deterministic seeds.
    
    This allows LLM creativity while maintaining kernel reproducibility.
    Each unique LLM output → unique but reproducible kernel run.
    """
    print("\n" + "="*70)
    print("EXAMPLE 4: DETERMINISTIC SEEDING FROM LLM")
    print("="*70)
    
    llm = OllamaClient(model="llama2")
    
    if not llm.is_available():
        print("❌ Ollama not available. Please start it with: ollama serve")
        return
    
    print("✓ Ollama connected\n")
    
    # Different scenarios
    scenarios = [
        "cooperative swarm exploring a maze",
        "competitive agents fighting for resources",
        "hierarchical team solving a puzzle"
    ]
    
    for scenario in scenarios:
        print(f"\nScenario: {scenario}")
        print("-" * 60)
        
        # LLM generates description
        prompt = f"Describe in exactly 10 words how agents would behave in: {scenario}"
        description = llm.generate(prompt, temperature=0.8, max_tokens=50)
        print(f"LLM description: {description}")
        
        # Hash the LLM output to get deterministic seed
        seed_hash = hashlib.sha256(description.encode()).hexdigest()
        seed = int(seed_hash[:8], 16) % 100000  # Convert to reasonable seed
        print(f"Generated seed: {seed}")
        
        # Initialize kernel with this seed
        kernel = AgentKernel(n_nodes=6, dim=4, seed=seed, format='Q1616')
        initial_hash = kernel.hash_state()
        
        # Run deterministically
        for t in range(5):
            kernel.step(K_mcmc=8, tau=0.15, beta=0.06, verbose=False)
        
        final_hash = kernel.hash_state()
        print(f"Initial hash: {initial_hash}")
        print(f"Final hash: {final_hash}")
        
        # Key insight: Running again with same LLM output gives same result!
        kernel2 = AgentKernel(n_nodes=6, dim=4, seed=seed, format='Q1616')
        for t in range(5):
            kernel2.step(K_mcmc=8, tau=0.15, beta=0.06, verbose=False)
        
        assert kernel2.hash_state() == final_hash
        print("✓ Reproducibility verified (same LLM output → same kernel result)")


