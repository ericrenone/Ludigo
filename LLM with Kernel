def example_llm_reward_designer():
    """
    Example: LLM designs the reward function based on user goal.
    
    User describes objective in natural language, LLM generates Python code
    for reward function, kernel optimizes using that reward.
    """
    print("\n" + "="*70)
    print("EXAMPLE 2: LLM AS REWARD FUNCTION DESIGNER")
    print("="*70)
    
    llm = OllamaClient(model="llama2")
    
    if not llm.is_available():
        print("❌ Ollama not available. Please start it with: ollama serve")
        return
    
    print("✓ Ollama connected")
    
    # User goal
    user_goal = "I want agents to form a circle pattern around the origin"
    print(f"\nUser goal: {user_goal}")
    
    # Ask LLM to design reward function
    prompt = f"""Design a reward function for a multi-agent system.

Goal: {user_goal}

Each agent has a 4D state vector [x0, x1, x2, x3].
Write Python code for a reward function that takes the state vector 'x' 
(list of Q16.16 numbers) and returns a Q1616 reward (higher is better).

Use: math.sqrt(), x[i].to_float(), and return Q1616(value)

Provide ONLY the function code, no explanation:"""
    
    llm_code = llm.generate(prompt, temperature=0.3, max_tokens=300)
    print(f"\nLLM-generated code:\n{llm_code}\n")
    
    # In production, you'd validate this code carefully!
    # For demo, we'll use a safe fallback
    print("⚠️  In production, validate LLM-generated code before exec!")
    print("Using safe fallback reward function for this demo.\n")
    
    # Initialize kernel with custom reward
    kernel = AgentKernel(n_nodes=6, dim=4, seed=4242, format='Q1616')
    
    # Define a safe reward function (encouraging circular pattern)
    def circle_reward(agent_node, x):
        """Reward agents for being at radius ~1.0 from origin."""
        import math
        floats = [xi.to_float() for xi in x]
        # Use first 2 dimensions as x, y coordinates
        radius = math.sqrt(floats[0]**2 + floats[1]**2)
        # Reward being near radius 1.0
        distance_from_target = abs(radius - 1.0)
        return Q1616(-distance_from_target)
    
    # Inject custom reward into all agents
    for node in kernel.nodes:
        original_reward = node.reward_scalar
        node.reward_scalar = lambda x, n=node: circle_reward(n, x)
    
    print("Running kernel with custom reward function...")
    for t in range(10):
        kernel.step(K_mcmc=12, tau=0.2, beta=0.08, verbose=False)
    
    print(f"\n✓ Optimized for 10 steps")
    print(f"✓ Final hash: {kernel.hash_state()}\n")
    
    # Show agent positions (first 2 dimensions as x, y)
    print("Agent positions (x, y from first 2 state dimensions):")
    for i, node in enumerate(kernel.nodes):
        x = node.x_self[0].to_float()
        y = node.x_self[1].to_float()
        radius = (x**2 + y**2)**0.5
        print(f"  Agent {i}: ({x:6.3f}, {y:6.3f}) radius={radius:.3f}")


