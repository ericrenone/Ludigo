def example_llm_guided_decisions():
    """
    Example: Use LLM to make high-level decisions for agents.
    
    The LLM generates suggestions, which are converted to deterministic
    Q16.16 parameters that the kernel executes.
    """
    print("\n" + "="*70)
    print("EXAMPLE 1: LLM-GUIDED AGENT DECISIONS")
    print("="*70)
    
    # Initialize LLM
    llm = OllamaClient(model="llama2")
    
    if not llm.is_available():
        print("❌ Ollama not available. Please start it with: ollama serve")
        return
    
    print("✓ Ollama connected")
    
    # Initialize kernel
    kernel = AgentKernel(n_nodes=6, dim=4, seed=4242, format='Q1616')
    print(f"✓ Kernel initialized (hash: {kernel.hash_state()})")
    
    # Run 5 steps with LLM guidance
    for step in range(5):
        print(f"\n--- Step {step + 1} ---")
        
        # Get current state of Agent 0
        agent_0_state = [x.to_float() for x in kernel.nodes[0].x_self]
        
        # Ask LLM for high-level strategy
        prompt = f"""You are controlling an agent in a multi-agent system.
Current state: {agent_0_state}
Goal: Minimize state magnitude while exploring.

Suggest a strategy in one sentence, then provide numerical parameters:
- exploration_factor: 0.0 to 1.0 (higher = more exploration)
- target_direction: -1.0 to 1.0 (direction to move)

Format: exploration_factor=X, target_direction=Y"""
        
        llm_response = llm.generate(prompt, temperature=0.7, max_tokens=150)
        print(f"LLM response: {llm_response[:200]}...")
        
        # Parse LLM output to extract parameters
        exploration = 0.5  # defaults
        direction = 0.0
        
        # Simple regex parsing
        exp_match = re.search(r'exploration_factor\s*=\s*([\d.]+)', llm_response)
        dir_match = re.search(r'target_direction\s*=\s*(-?[\d.]+)', llm_response)
        
        if exp_match:
            exploration = float(exp_match.group(1))
        if dir_match:
            direction = float(dir_match.group(1))
        
        print(f"Parsed: exploration={exploration:.3f}, direction={direction:.3f}")
        
        # Convert to deterministic Q16.16 and use as MCMC parameters
        # This maintains determinism: LLM suggests, kernel executes deterministically
        tau = 0.1 + exploration * 0.3  # Higher exploration = higher temperature
        beta = 0.05 + abs(direction) * 0.05  # Larger direction = larger steps
        
        # Execute kernel step (deterministic!)
        kernel.step(K_mcmc=8, tau=tau, beta=beta, verbose=False)
        
        print(f"Kernel hash: {kernel.hash_state()}")
    
    print(f"\n✓ Completed 5 LLM-guided steps")
    print(f"✓ Final hash: {kernel.hash_state()}")
    print("\nNote: Due to LLM non-determinism, hash sequence varies.")
    print("But each kernel.step() is internally deterministic given its parameters!")


